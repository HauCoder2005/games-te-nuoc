{
  "private": true,
  "name": "@te-nuoc/server",
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --external:colyseus --external:@colyseus/* --external:express",
    "test": "vitest run --pool=threads --no-file-parallelism test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "@te-nuoc/shared": "0.1.0",
    "colyseus": "^0.18.2",
    "express": "^5.2.1"
  }
}
